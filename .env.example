# Anthropic (for report generation)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# GoHighLevel
GHL_API_KEY=your-ghl-pit-key-here
GHL_LOCATION_ID=your-location-id-here
GHL_CLIENT_TAG=weekly-report        # Tag this on any GHL contact who should get the email
SENDING_DOMAIN=tulivodigital.com

# Google Drive (for creating the Doc automatically)
# Option A: paste the contents of your service account JSON, base64-encoded
GOOGLE_CREDENTIALS=
# Option B: path to the service account JSON file (easier for local testing)
GOOGLE_CREDENTIALS_FILE=google-credentials.json

# Fallback if Google Doc creation fails
FALLBACK_DOC_URL=https://tulivodigital.com
