# Anthropic — get from console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# GoHighLevel — paste the webhook URL from your GHL workflow trigger
# (no API key or scopes needed — GHL handles the email send internally)
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/YOUR-WEBHOOK-ID/webhook-trigger/...

# Google Drive (optional — for auto-creating the Doc each week)
# Leave blank to skip; the fallback URL will be used in the GHL email instead
GOOGLE_CREDENTIALS_FILE=google-credentials.json   # path to service account JSON
# OR for GitHub Actions use GOOGLE_CREDENTIALS with base64-encoded JSON

# Fallback link used in the GHL email if Google Doc creation is skipped
FALLBACK_DOC_URL=https://tulivodigital.com
